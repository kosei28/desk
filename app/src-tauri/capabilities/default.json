{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインのウィンドウ。帯でウィンドウを動かすこと、アプリのコマンド（帯のダブルクリック、ツリーの索引と本文、図の中のリンクを解く、ルートを選ぶ、外の URL を既定のアプリで開く）と、ツリーが変わった知らせを聞くことだけを許す",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-titlebar-double-click",
    "allow-index",
    "allow-body",
    "allow-resolve-link",
    "allow-choose-root",
    "allow-open-url"
  ]
}
