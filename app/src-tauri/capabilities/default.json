{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインのウィンドウ。帯でウィンドウを動かすこと、アプリのコマンド（帯のダブルクリック、ツリーの索引、ルートを選ぶ）と、ツリーが変わった知らせを聞くことだけを許す",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-titlebar-double-click",
    "allow-index",
    "allow-choose-root"
  ]
}
